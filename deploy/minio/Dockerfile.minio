# The official MinIO image is UBI9-based and requires x86-64-v2; the MinIO
# binary itself is statically linked, so it is repacked on Debian for hosts
# whose virtual CPU exposes only x86-64-v1.
FROM minio/minio:RELEASE.2025-07-23T15-54-02Z AS upstream

FROM debian:12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=upstream /usr/bin/minio /usr/bin/minio
EXPOSE 9000 9001
ENTRYPOINT ["/usr/bin/minio"]
