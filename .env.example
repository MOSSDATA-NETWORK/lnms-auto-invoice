# PostgreSQL: use three independent, randomly generated passwords.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_APP_PASSWORD=

# MinIO root is used only by minio-init. Every runtime receives its own key.
MINIO_ROOT_USER=auto-invoice-root
MINIO_ROOT_PASSWORD=
S3_BUCKET=auto-invoice
S3_API_ACCESS_KEY=auto-invoice-api
S3_API_SECRET_KEY=
S3_RENDER_ACCESS_KEY=auto-invoice-render
S3_RENDER_SECRET_KEY=
S3_SYNC_ACCESS_KEY=auto-invoice-sync
S3_SYNC_SECRET_KEY=
S3_NOTIFICATION_ACCESS_KEY=auto-invoice-notification
S3_NOTIFICATION_SECRET_KEY=
S3_IMPORT_ACCESS_KEY=auto-invoice-import
S3_IMPORT_SECRET_KEY=
S3_BILLING_ACCESS_KEY=auto-invoice-billing
S3_BILLING_SECRET_KEY=

# Generate with: openssl rand -base64 32
AUTO_INVOICE_MASTER_KEY_BASE64=

# Comma-separated exact origins only. Paths, credentials, query strings and
# fragments are rejected. Replace this documentation-only test origin.
LIBRENMS_ALLOWED_ORIGINS=https://librenms.example.invalid

# Enable only for the first empty-database bootstrap, then disable it. The
# bootstrap password expires after 24 hours and must be changed on first login.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_PASSWORD=

# Keep true behind TLS. Set false explicitly only for local plain-HTTP testing.
SESSION_COOKIE_SECURE=true
# Runtime API documentation is an explicit local/controlled-environment opt-in.
# Production Web does not proxy these endpoints; the committed static contract
# remains the source for frontend generation.
OPENAPI_DOCS_ENABLED=false
SWAGGER_UI_ENABLED=false
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088
# Exact address or narrow CIDR of the immediate external TLS proxy as observed
# by the Web container. TEST-NET-1 is the safe "trust nobody" default.
AUTO_INVOICE_TRUSTED_PROXY_CIDR=192.0.2.1/32

# Container resource ceilings. Tune from measured production load; keep finite limits in every environment.
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=1g
API_PIDS_LIMIT=256
WORKER_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=1g
WORKER_PIDS_LIMIT=256
RENDER_WORKER_CPU_LIMIT=2.0
RENDER_WORKER_MEMORY_LIMIT=2g
RENDER_WORKER_PIDS_LIMIT=512
RENDER_WORKER_SHM_SIZE=1g
IMPORT_WORKER_CPU_LIMIT=1.5
IMPORT_WORKER_MEMORY_LIMIT=1536m
WEB_CPU_LIMIT=0.5
WEB_MEMORY_LIMIT=256m
WEB_PIDS_LIMIT=128

# Production must supply a real SMTP endpoint. For local development, set
# SMTP_HOST=mailpit and start Compose with --profile dev.
NOTIFICATION_EMAIL_FROM=no-reply@example.com
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_STARTTLS_REQUIRED=false
SMTP_CHECK_SERVER_IDENTITY=false
SMTP_ALLOW_INSECURE=true
MAILPIT_PORT=8025
